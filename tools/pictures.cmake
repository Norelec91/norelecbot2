# Builds the pictures in assets/ into a source file, as bytes: the bot carries them inside its binary.
# Each entry is name:file:mime.
set(NORELECBOT_PICTURES
    "launch:launch.jpg:image/jpeg"
    "blast:blast.gif:image/gif"
    "impact:impact.jpg:image/jpeg"
    "fallout:fallout.png:image/png"
)

set(pictures_source "${CMAKE_BINARY_DIR}/generated/pictures.cpp")
set(pictures_arrays "")
set(pictures_table "")
foreach(entry IN LISTS NORELECBOT_PICTURES)
    string(REPLACE ":" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 file)
    list(GET parts 2 mime)
    set(path "${CMAKE_SOURCE_DIR}/assets/${file}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND pictures_arrays "constexpr unsigned char ${name}_bytes[${size}] = {${bytes}};\n")
    string(APPEND pictures_table
        "    Picture{\"${name}\", \"${file}\", \"${mime}\", "
        "std::string_view{reinterpret_cast<const char *>(${name}_bytes), sizeof ${name}_bytes}},\n")
endforeach()

file(WRITE "${pictures_source}.new" "/* Generated by tools/pictures.cmake from assets/: do not edit. */
#include \"pictures.hpp\"

#include <algorithm>
#include <array>

namespace norelecbot {
namespace {

${pictures_arrays}
}

const Picture *picture(std::string_view name) {
    static const std::array pictures{
${pictures_table}    };
    const auto found = std::ranges::find(pictures, name, &Picture::name);
    return found != pictures.end() ? &*found : nullptr;
}

}
")
file(COPY_FILE "${pictures_source}.new" "${pictures_source}" ONLY_IF_DIFFERENT)
